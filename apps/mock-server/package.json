{
  "name": "@nerkh/mock-server",
  "version": "0.0.0",
  "private": true,
  "description": "WebSocket server that streams seeded mock quotes for development, CI and demos",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nerkh/data": "workspace:*",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@nerkh/config": "workspace:*",
    "@nerkh/ws-client": "workspace:*",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
